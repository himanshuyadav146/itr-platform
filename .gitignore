# =============================================================================
# ITR Platform — Monorepo .gitignore
# Covers: apps/api (PHP), apps/admin (React/Vite), apps/mobile (Flutter)
# =============================================================================

# -----------------------------------------------------------------------------
# Operating system
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*~
.directory
.Trash-*

# -----------------------------------------------------------------------------
# IDEs & editors
# -----------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.history/
.atom/
.buildlog/

# -----------------------------------------------------------------------------
# Environment & secrets (never commit)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.local.php
local_config.php
local_settings.php

# API — sensitive config (use *.example templates instead)
apps/api/include/config.php
apps/api/include/payment_config.php
apps/api/include/firebase_config.php
apps/api/include/*.local.php

# SSL / keys / certificates
*.pem
*.key
*.crt
*.cert
*.jks
*.keystore
**/key.properties
ssl/

# Firebase service account (server-side only)
**/firebase-adminsdk*.json
**/*service*account*.json

# -----------------------------------------------------------------------------
# Nested git repos (remove these dirs when consolidating into monorepo)
# -----------------------------------------------------------------------------
apps/admin/.git/
apps/api/.git/
apps/mobile/tax_client/.git/

# -----------------------------------------------------------------------------
# Node.js — Admin panel (apps/admin)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/
.npm/
.yarn/
dist/
dist-ssr/
build/
coverage/
*.tsbuildinfo
.vite/
.cache/

# Admin env files
apps/admin/.env.local
apps/admin/.env.production
apps/admin/.env.development
apps/admin/.env.test

# -----------------------------------------------------------------------------
# PHP — API (apps/api)
# -----------------------------------------------------------------------------
apps/api/vendor/
apps/api/composer.phar
apps/api/.phpunit.result.cache
apps/api/phpunit.xml

# User uploads (keep directory structure only)
apps/api/uploads/*
!apps/api/uploads/.gitkeep
!apps/api/uploads/.htaccess

# API logs
apps/api/**/*.log
apps/api/error_log
apps/api/error_log.txt
apps/api/logs/

# -----------------------------------------------------------------------------
# Flutter / Dart — Mobile (apps/mobile/tax_client)
# -----------------------------------------------------------------------------
apps/mobile/tax_client/.dart_tool/
apps/mobile/tax_client/.flutter-plugins
apps/mobile/tax_client/.flutter-plugins-dependencies
apps/mobile/tax_client/.pub-cache/
apps/mobile/tax_client/.pub/
apps/mobile/tax_client/build/
apps/mobile/tax_client/**/doc/api/

# Flutter generated / symbolication
apps/mobile/tax_client/app.*.symbols
apps/mobile/tax_client/app.*.map.json

# Android build outputs
apps/mobile/tax_client/android/app/debug/
apps/mobile/tax_client/android/app/profile/
apps/mobile/tax_client/android/app/release/
apps/mobile/tax_client/android/.gradle/
apps/mobile/tax_client/android/local.properties
apps/mobile/tax_client/android/captures/

# iOS / macOS generated
apps/mobile/tax_client/ios/Flutter/.last_build_id
apps/mobile/tax_client/ios/Pods/
apps/mobile/tax_client/ios/.symlinks/
apps/mobile/tax_client/ios/Flutter/Flutter.framework
apps/mobile/tax_client/ios/Flutter/Flutter.podspec
apps/mobile/tax_client/macos/Flutter/ephemeral/
apps/mobile/tax_client/**/DerivedData/

# -----------------------------------------------------------------------------
# Logs & temp files
# -----------------------------------------------------------------------------
*.log
*.tmp
*.temp
*.swp
*.swo
tmp/
temp/
.cache/

# -----------------------------------------------------------------------------
# Backups & archives (generated, not source)
# -----------------------------------------------------------------------------
*.bak
*.backup
*.old
*.orig
*_backup.*
*_old.*
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Admin deployment artifacts
apps/admin/dist/
apps/admin/dist/**

# API deployment archives
apps/api/admin.zip
apps/api/**/*.zip

# -----------------------------------------------------------------------------
# Database dumps (local only)
# -----------------------------------------------------------------------------
*.sql.bak
*.sql.backup
*.db
*.sqlite
*.sqlite3

# -----------------------------------------------------------------------------
# Testing output
# -----------------------------------------------------------------------------
tests/_output/
coverage/
.nyc_output/

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
.svn/
.swiftpm/
migrate_working_dir/
*.class
*.pyc
