# API Base URL Configuration
# 
# Development: Leave empty/unset to use Vite proxy (/api -> http://localhost/api)
# Production: Set to your production API base URL
# 
# Examples:
# VITE_API_BASE_URL=https://api.yourdomain.com
# VITE_API_BASE_URL=https://yourdomain.com/api
VITE_API_BASE_URL=http://allindiaitr.in

# Optional: if your backend uses /api/login.php instead of /api/auth/login.php
# VITE_LOGIN_PATH=/login.php
