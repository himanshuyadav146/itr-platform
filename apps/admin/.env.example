# API Base URL Configuration
#
# Development: leave empty so Vite proxies /api -> http://localhost/api
# Production build: set the live origin (no trailing slash)
#
# VITE_API_BASE_URL=https://allindiaitr.in
VITE_API_BASE_URL=

# Optional: if your backend uses /api/login.php instead of /api/auth/login.php
# VITE_LOGIN_PATH=/login.php
