# Used only if you opt into env-based URLs. Local `npm run dev` already
# calls /api and Vite proxies that to http://localhost/api.
# Leave empty for local XAMPP.
VITE_API_BASE_URL=

# Admin panel origin (associate login after website registration).
# Local default in code is http://localhost:5173 — override if your admin port differs.
# VITE_ADMIN_ORIGIN=http://localhost:5173

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true
