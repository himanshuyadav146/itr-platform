# ============================================
# ITR API - .gitignore
# ============================================

# ============================================
# Sensitive Configuration Files
# ============================================
include/config.php
include/payment_config.php
*.env
.env.local
.env.production

# ============================================
# User Uploads & Generated Files
# ============================================
uploads/*
!uploads/.gitkeep
!uploads/.htaccess

# ============================================
# Error Logs
# ============================================
*.log
error_log
error_log.txt
logs/
*.log.*
**/error_log
auth/error_log
itrdetails/error_log

# ============================================
# PHP Specific
# ============================================
# Composer
/vendor/
composer.phar
composer.lock

# PHPStorm / IDE
.idea/
.phpstorm.meta.php
.phpstorm.meta.php_*

# ============================================
# Operating System Files
# ============================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.directory
.Trash-*

# ============================================
# Temporary Files
# ============================================
*.tmp
*.temp
*.swp
*.swo
*~
.cache/
tmp/
temp/

# ============================================
# Backup Files
# ============================================
*.bak
*.backup
*.old
*.orig
*_backup.*
*_old.*

# ============================================
# Database Files
# ============================================
*.sql.bak
*.sql.backup
*.db
*.sqlite
*.sqlite3

# ============================================
# Archive Files (if not needed in repo)
# ============================================
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# ============================================
# Node.js (if using any frontend tools)
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ============================================
# Testing
# ============================================
.phpunit.result.cache
phpunit.xml
tests/_output/

# ============================================
# Documentation Build (if any)
# ============================================
docs/_build/
site/

# ============================================
# Local Development Files
# ============================================
local/
local_config.php
local_settings.php
*.local.php

# ============================================
# SSL Certificates (if any)
# ============================================
*.pem
*.key
*.crt
*.cert
ssl/

# ============================================
# Build / Dist Files
# ============================================
dist/
build/
*.min.js
*.min.css

# ============================================
# Keep Important Empty Directories
# ============================================
# Create these files manually if needed:
# uploads/.gitkeep
# logs/.gitkeep

