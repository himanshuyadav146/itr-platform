/**
 * Firebase / FCM configuration for push notifications
 * Copy this file to firebase_config.php and set your values.
 * Do NOT commit firebase_config.php or your service account JSON to version control.
 */

// Your Firebase project ID (from Firebase Console > Project Settings)
$firebase_project_id = 'your-project-id';

// Absolute path to your Firebase service account JSON key file
// Download from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
$firebase_service_account_path = __DIR__ . '/firebase-service-account.json';

