$notification_smtp_secure = 'tls'; // tls or ssl
$notification_smtp_username = 'your-email@gmail.com';
$notification_smtp_password = 'your-app-password';
$notification_from_email = 'your-email@gmail.com';
$notification_from_name = 'FinApp';

