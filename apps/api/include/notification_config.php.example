/**
 * Email (SMTP) configuration for transactional notifications.
 *
 * SETUP (free options):
 * 1. Gmail: enable 2FA → App Password → use smtp.gmail.com:587
 * 2. Zoho Mail: use your domain mailbox SMTP settings
 *
 * Copy to notification_config.php (never commit notification_config.php)
 */

